---
interface Props { homeHref: string; hasEssay: boolean; hasActivities: boolean; activityTabLabel?: string }
const { homeHref, hasEssay, hasActivities, activityTabLabel = '생각 펼치기' } = Astro.props;
const tabs = [
  { id: 'story', label: '이야기 읽기' },
  ...(hasEssay ? [{ id: 'essay', label: '어른의 시선' }] : []),
  ...(hasActivities ? [{ id: 'harvard', label: activityTabLabel }] : []),
];
---

<book-tabs>
  <header>
    <a href={homeHref} class="back-btn">← 서재</a>
    <div class="nav-btns" role="tablist" aria-label="이야기와 생각 확장">
      {tabs.map((tab, index) => (
        <button id={`tab-${tab.id}`} role="tab" type="button"
          aria-controls={tab.id} aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1} data-target={tab.id}>
          {tab.label}
        </button>
      ))}
    </div>
  </header>
  <main>
    {tabs.map((tab, index) => (
      <section id={tab.id} role="tabpanel" aria-labelledby={`tab-${tab.id}`}
        tabindex="0" class="tab-content" hidden={index !== 0}>
        {tab.id === 'story' && <slot name="story" />}
        {tab.id === 'essay' && <slot name="essay" />}
        {tab.id === 'harvard' && <slot name="activities" />}
      </section>
    ))}
  </main>
</book-tabs>

<script>
  class BookTabs extends HTMLElement {
    headerObserver?: ResizeObserver;
    disconnectedCallback() { this.headerObserver?.disconnect(); }
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const header = this.querySelector('header');
      if (header) {
        this.headerObserver = new ResizeObserver(() => {
          this.style.setProperty('--book-header-height', `${header.getBoundingClientRect().height + 16}px`);
        });
        this.headerObserver.observe(header, { box: 'border-box' });
      }
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = this.querySelectorAll<HTMLElement>('[role="tabpanel"]');
      const activate = (button: HTMLButtonElement) => {
        buttons.forEach((item) => {
          const selected = item === button;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.id !== button.dataset.target; });
        // Switching from a scrolled story/essay must reveal the new panel's start.
        this.querySelector<HTMLElement>(`#${button.dataset.target}`)?.scrollIntoView({ block: 'start', behavior: 'instant' });
      };
      // Both React completion actions and editorial return buttons reuse activate().
      const navigate = (tab: string | undefined) => {
        const button = buttons.find(button => button.dataset.target === tab);
        if (!button) return;
        activate(button);
        this.querySelector<HTMLElement>(`#${button.dataset.target}`)?.focus({ preventScroll: true });
      };
      this.addEventListener('book-tab-request', event => {
        navigate((event as CustomEvent<{ tab?: string }>).detail?.tab);
      });
      this.addEventListener('click', event => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-book-tab]') : null;
        if (button) {
          this.querySelector('.story-viewer')?.dispatchEvent(new Event('book-completion-request'));
          navigate(button.dataset.bookTab);
        }
      });
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => activate(button));
        button.addEventListener('keydown', (event) => {
          let next: number;
          switch (event.key) {
            case 'ArrowRight': next = (index + 1) % buttons.length; break;
            case 'ArrowLeft': next = (index - 1 + buttons.length) % buttons.length; break;
            case 'Home': next = 0; break;
            case 'End': next = buttons.length - 1; break;
            default: return;
          }
          event.preventDefault();
          activate(buttons[next]);
          buttons[next].focus({ preventScroll: true });
          buttons[next].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
        });
      });
    }
  }
  if (!customElements.get('book-tabs')) customElements.define('book-tabs', BookTabs);
</script>

<style>
  book-tabs { display: block; }
  header { display: flex; flex-wrap: nowrap; gap: 12px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e5e7eb; align-items: center; position: sticky; top: 0; z-index: 100; overflow-wrap: anywhere; }
  .back-btn { text-decoration: none; color: #4b5563; font-weight: bold; font-size: .95rem; flex-shrink: 0; min-height: 44px; display: flex; align-items: center; }
  .nav-btns { display: flex; min-width: 0; gap: 6px; overflow-x: auto; padding: 4px; }
  .nav-btns button { flex-shrink: 0; min-height: 44px; padding: 8px 12px; font: inherit; font-size: .9rem; white-space: nowrap; border-radius: 20px; border: 1px solid #d1d5db; background: #fff; cursor: pointer; font-weight: 600; transition: background-color .15s; }
  .nav-btns button[aria-selected='true'], .nav-btns button:hover { background: #22252a; color: #fff; border-color: #22252a; }
  .tab-content { scroll-margin-top: var(--book-header-height, 10rem); box-sizing: border-box; max-width: 920px; margin: 24px auto; padding: 0 16px; width: 100%; }
  @media (max-width: 480px) { header { gap: 6px; padding: 6px 8px; } .tab-content { padding: 0 12px; margin-top: 16px; } }
  @media (prefers-reduced-motion: reduce) { .nav-btns button { transition: none; } }
</style>
