---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookTabs from '../../components/book/BookTabs.astro';
import EssayPanel from '../../components/book/EssayPanel.astro';
import ActivityPanel from '../../components/book/ActivityPanel.astro';
import StoryViewer from '../../components/StoryViewer';
import { getLibrary } from '../../lib/content';
import '../../styles/book.css';

export const getStaticPaths = (async () => {
  const library = await getLibrary();
  return library.map(({ book, essay }) => ({
    params: { id: book.id },
    props: { book, essay },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { book, essay } = Astro.props;
const activities = book.data.harvardPlay ?? [];
---

<BaseLayout title={`${book.data.title} | PHILO-PAIRING`} pageClass="book-page">
  <BookTabs hasEssay={Boolean(essay)} hasActivities={activities.length > 0}>
    <StoryViewer slot="story" client:load pages={book.data.pages} title={book.data.title} />
    {essay && <EssayPanel slot="essay" essay={essay} />}
    {activities.length > 0 && <ActivityPanel slot="activities" activities={activities} />}
  </BookTabs>
</BaseLayout>
