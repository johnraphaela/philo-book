---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/library/BookCard.astro';
import { getLibrary } from '../lib/content';
const library = await getLibrary();
---

<BaseLayout title="PHILO-PAIRING | 우리의 그림책 서가" pageClass="library-page">
  <header>
    <h1 style="margin-bottom: 5px;">📚 PHILO-PAIRING</h1>
    <p style="color: #666;">아이와 부모가 함께 읽는 생각 동화책</p>
  </header>
  <main class="book-grid">
    {library.map(({ book }) => <BookCard book={book} />)}
  </main>
</BaseLayout>

<style>
  :global(body.library-page) { padding: 20px; }
  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-top: 30px; }
</style>
