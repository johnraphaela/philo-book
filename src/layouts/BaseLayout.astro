---
import '../styles/global.css';
import '../styles/library-a.css';

interface Props {
  title: string;
  pageClass?: string;
}
const { title, pageClass } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <slot />
  </body>
</html>
