---
import type { CollectionEntry } from 'astro:content';
import BookCard from './BookCard.astro';
import { AGE_BANDS, TOPICS } from '../../lib/library';
interface Props { books: CollectionEntry<'books'>[] }
const { books } = Astro.props;
---

<library-shelf>
  <form hidden role="search" aria-label="그림책 찾기">
    <label class="search">책 검색
      <input type="search" name="query" placeholder="제목, 소개, 태그로 검색" autocomplete="off" />
    </label>
    <div class="field">
      <label for="library-age">추천 연령</label>
      <select id="library-age" name="age">
        <option value="">모든 연령</option>
        {AGE_BANDS.map(band => <option value={band.id}>{band.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="library-topic">주제</label>
      <select id="library-topic" name="topic">
        <option value="">모든 주제</option>
        {TOPICS.map(topic => <option value={topic.id}>{topic.label}</option>)}
      </select>
    </div>
    <button type="reset">초기화</button>
  </form>
  <p class="result-count" role="status" aria-live="polite" aria-atomic="true">전체 {books.length}권</p>
  <noscript><p>검색·필터는 JavaScript를 켜면 사용할 수 있어요. 아래에서 모든 책을 살펴보세요.</p></noscript>
  <div class="book-grid">
    {books.map(book => <BookCard book={book} />)}
  </div>
  <div class="empty" hidden>
    <p>찾는 책이 없어요. 검색어나 필터를 바꿔 보세요.</p>
    <button type="button" data-clear>전체 책 보기</button>
  </div>
</library-shelf>

<script>
  import { matchesBook, type LibraryItem } from '../../lib/library';
  class LibraryShelf extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const form = this.querySelector<HTMLFormElement>('form')!;
      const query = form.querySelector<HTMLInputElement>('[name="query"]')!;
      const age = form.querySelector<HTMLSelectElement>('[name="age"]')!;
      const topic = form.querySelector<HTMLSelectElement>('[name="topic"]')!;
      const cards = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-book]'))
        .map(element => ({ element, book: JSON.parse(element.dataset.book!) as LibraryItem }));
      const count = this.querySelector<HTMLElement>('.result-count')!;
      const empty = this.querySelector<HTMLElement>('.empty')!;
      const update = () => {
        let visible = 0;
        for (const { element, book } of cards) {
          const match = matchesBook(book, query.value, age.value, topic.value);
          element.hidden = !match;
          if (match) visible++;
        }
        count.textContent = `전체 ${cards.length}권 중 ${visible}권`;
        empty.hidden = visible !== 0;
      };
      form.addEventListener('submit', event => event.preventDefault());
      form.addEventListener('input', update);
      form.addEventListener('change', update);
      // Native form values reset after the reset event's default action.
      form.addEventListener('reset', () => setTimeout(update, 0));
      this.querySelector('[data-clear]')!.addEventListener('click', () => {
        form.reset();
        query.focus();
      });
      form.hidden = false;
      update();
    }
  }
  if (!customElements.get('library-shelf')) customElements.define('library-shelf', LibraryShelf);
</script>

<style>
  library-shelf { display: block; }
  form { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; margin-top: 28px; padding: 20px; background: #fff; border-radius: 12px; }
  .field { display: grid; gap: 8px; }
  label { display: grid; gap: 8px; font-weight: 600; font-size: .9rem; }
  .search { flex: 1 1 240px; }
  input, select, button { font: inherit; box-sizing: border-box; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; background: #fff; color: #22252a; min-height: 44px; }
  input { width: 100%; min-width: 0; }
  input:focus-visible, select:focus-visible { outline: 3px solid #2563eb; outline-offset: 2px; }
  button { cursor: pointer; }
  .result-count { color: #4b5563; margin-top: 20px; }
  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 20px; margin-top: 20px; }
  .empty { text-align: center; padding: 40px 16px; background: #fff; border-radius: 12px; }
  @media (max-width: 480px) { form { gap: 12px; } label, .field { flex: 1 1 100%; } }
</style>
